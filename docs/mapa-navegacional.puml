@startuml MapaNavegacional
title Mapa Navegacional VetCare (FSM Actualizado)

' Evita que la imagen supere el limite de ancho al exportar
scale max 4000 width
hide empty description
top to bottom direction

skinparam nodesep 35
skinparam ranksep 50
skinparam padding 10
skinparam ArrowThickness 1.2
skinparam StateBackgroundColor #FFFDF5
skinparam StateBorderColor #8B2635
skinparam LegendFontSize 11

state "index" as index

[*] --> index
index --> recepcionista_dashboard : 1
index --> consultar_citas : 2
index --> admin_dashboard : 3

' =========================================================
' ROL: ADMINISTRADOR
' =========================================================
state "Administrador" as mod_admin {
  state "admin-dashboard" as admin_dashboard

  state "Gestion Veterinarios" as sub_vet {
    state "veterinarios-listado" as veterinarios_listado
    state "veterinarios-nuevo" as veterinarios_nuevo
    state "veterinarios-editar" as veterinarios_editar
    state "veterinarios-eliminar" as veterinarios_eliminar
  }

  state "Gestion Servicios" as sub_serv {
    state "servicios-listado" as servicios_listado
    state "servicios-nuevo" as servicios_nuevo
    state "servicios-editar" as servicios_editar
    state "servicios-eliminar" as servicios_eliminar
  }

  admin_dashboard --> admin_dashboard : 5
  admin_dashboard --> veterinarios_listado : 6
  admin_dashboard --> servicios_listado : 7

  veterinarios_listado --> veterinarios_listado : 8
  veterinarios_listado --> veterinarios_nuevo : 9
  veterinarios_listado --> veterinarios_editar : 10
  veterinarios_listado --> veterinarios_eliminar : 11
  veterinarios_nuevo --> veterinarios_listado : 12
  veterinarios_editar --> veterinarios_listado : 13
  veterinarios_eliminar --> veterinarios_listado : 14

  servicios_listado --> servicios_listado : 15
  servicios_listado --> servicios_nuevo : 16
  servicios_listado --> servicios_editar : 17
  servicios_listado --> servicios_eliminar : 18
  servicios_nuevo --> servicios_listado : 19
  servicios_editar --> servicios_listado : 20
  servicios_eliminar --> servicios_listado : 21

  veterinarios_listado --> servicios_listado : 22
  servicios_listado --> veterinarios_listado : 23
}

mod_admin --> index : 4

' =========================================================
' ROL: VETERINARIO
' =========================================================
state "Veterinario" as mod_vet {
  state "Citas" as sub_vet_citas {
    state "citas-listado" as consultar_citas
    state "atencion-registrar" as atencion_registrar
  }

  state "Historial clinico" as sub_vet_hist {
    state "buscar-historial" as historial_buscar
    state "historial-detalle" as historial_detalle
  }

  consultar_citas --> consultar_citas : 25
  consultar_citas --> atencion_registrar : 26
  atencion_registrar --> consultar_citas : 27
  consultar_citas --> historial_buscar : 28
  historial_buscar --> consultar_citas : 29
  historial_buscar --> historial_buscar : 30
  historial_buscar --> historial_detalle : 31
  historial_detalle --> historial_buscar : 32
}

mod_vet --> index : 24

' =========================================================
' ROL: RECEPCIONISTA
' =========================================================
state "Recepcionista" as mod_recepcion {
  state "recepcionista-dashboard" as recepcionista_dashboard

  state "Propietarios" as sub_prop {
    state "propietarios-listado" as propietarios_listado
    state "propietarios-nuevos" as propietarios_nuevo
    state "propietarios-editar" as propietarios_editar
    state "propietarios-eliminar" as propietarios_eliminar
  }

  state "Mascotas" as sub_masc {
    state "mascotas-listado" as mascotas_listado
    state "mascotas-nuevo" as mascotas_nuevo
    state "mascotas-editar" as mascotas_editar
    state "mascotas-eliminar" as mascotas_eliminar
  }

  state "Citas" as sub_citas {
    state "citas-listado" as citas_listado
    state "citas-agendar" as citas_agendar
    state "citas-reprogramar" as citas_reprogramar
    state "citas-cancelar" as citas_cancelar
  }

  recepcionista_dashboard --> recepcionista_dashboard : 34
  recepcionista_dashboard --> propietarios_listado : 35
  recepcionista_dashboard --> mascotas_listado : 36
  recepcionista_dashboard --> citas_listado : 37
  recepcionista_dashboard --> citas_reprogramar : 38
  recepcionista_dashboard --> citas_cancelar : 39

  propietarios_listado --> propietarios_listado : 40
  propietarios_listado --> propietarios_nuevo : 41
  propietarios_listado --> propietarios_editar : 42
  propietarios_listado --> propietarios_eliminar : 43
  propietarios_nuevo --> propietarios_listado : 44
  propietarios_nuevo --> mascotas_nuevo : 45
  propietarios_editar --> propietarios_listado : 46
  propietarios_eliminar --> propietarios_listado : 47

  mascotas_listado --> mascotas_listado : 48
  mascotas_listado --> mascotas_nuevo : 49
  mascotas_listado --> mascotas_editar : 50
  mascotas_listado --> mascotas_eliminar : 51
  mascotas_nuevo --> mascotas_listado : 52
  mascotas_nuevo --> citas_agendar : 53
  mascotas_editar --> mascotas_listado : 54
  mascotas_eliminar --> mascotas_listado : 55

  citas_listado --> citas_listado : 56
  citas_listado --> citas_agendar : 57
  citas_listado --> citas_reprogramar : 58
  citas_listado --> citas_cancelar : 59
  citas_agendar --> citas_agendar : 60
  citas_agendar --> citas_listado : 61
  citas_agendar --> propietarios_nuevo : 62
  citas_agendar --> mascotas_nuevo : 63
  citas_reprogramar --> citas_listado : 64
  citas_cancelar --> citas_listado : 65
}

mod_recepcion --> index : 33

' =========================================================
' LEYENDA DE TRANSICIONES (Evento [Condicion de guarda] - CU)
' =========================================================
legend bottom
  |= General y Administrador (1 - 23) |= Veterinario (24 - 32) |
  | **1.** index -> recepcionista-dashboard: Clic en "Recepcionista" [correo y contrasena validos] (CU-01)\n**2.** index -> citas-listado (vet): Clic en "Medico veterinario" [correo y contrasena validos] (CU-01)\n**3.** index -> admin-dashboard: Clic en "Administrador" [correo y contrasena validos] (CU-01)\n**4.** Administrador -> index: Clic en "Cerrar sesion" desde cualquier vista del rol\n**5.** admin-dashboard -> admin-dashboard: Clic en "Panel principal" o logo "VetCare"\n**6.** admin-dashboard -> veterinarios-listado: Clic en "Veterinarios" en menu lateral (CU-09)\n**7.** admin-dashboard -> servicios-listado: Clic en "Servicios" en menu lateral (CU-10)\n**8.** veterinarios-listado -> veterinarios-listado: Clic en "Buscar", "Limpiar" o "Veterinarios" en menu (CU-09)\n**9.** veterinarios-listado -> veterinarios-nuevo: Clic en "Nuevo veterinario" (CU-09)\n**10.** veterinarios-listado -> veterinarios-editar: Clic en "Editar" en fila de la tabla (CU-09)\n**11.** veterinarios-listado -> veterinarios-eliminar: Clic en "Eliminar" en fila de la tabla (CU-09)\n**12.** veterinarios-nuevo -> veterinarios-listado: Clic en "Guardar" [datos validos] o "Cancelar" / "Volver al listado" (CU-09)\n**13.** veterinarios-editar -> veterinarios-listado: Clic en "Guardar cambios" [datos validos] o "Cancelar" / "Volver al listado" (CU-09)\n**14.** veterinarios-eliminar -> veterinarios-listado: Clic en "Eliminar" [casilla marcada] o "Cancelar" / "Volver al listado" (CU-09)\n**15.** servicios-listado -> servicios-listado: Clic en "Buscar", "Limpiar" o "Servicios" en menu (CU-10)\n**16.** servicios-listado -> servicios-nuevo: Clic en "Nuevo servicio" (CU-10)\n**17.** servicios-listado -> servicios-editar: Clic en "Editar" en fila de la tabla (CU-10)\n**18.** servicios-listado -> servicios-eliminar: Clic en "Eliminar" en fila de la tabla (CU-10)\n**19.** servicios-nuevo -> servicios-listado: Clic en "Guardar" [datos validos] o "Cancelar" / "Volver al listado" (CU-10)\n**20.** servicios-editar -> servicios-listado: Clic en "Guardar cambios" [datos validos] o "Cancelar" / "Volver al listado" (CU-10)\n**21.** servicios-eliminar -> servicios-listado: Clic en "Eliminar" [casilla marcada] o "Cancelar" / "Volver al listado" (CU-10)\n**22.** veterinarios-listado -> servicios-listado: Clic en "Servicios" en menu lateral (CU-10)\n**23.** servicios-listado -> veterinarios-listado: Clic en "Veterinarios" en menu lateral (CU-09) | **24.** Veterinario -> index: Clic en "Cerrar sesion" desde cualquier vista del rol\n**25.** citas-listado (vet) -> citas-listado (vet): Clic en "Buscar" [fecha valida], "Limpiar", "Consultar citas" o logo (CU-06)\n**26.** citas-listado (vet) -> atencion-registrar: Clic en "Atender" [cita en estado Programada] (CU-06, CU-07)\n**27.** atencion-registrar -> citas-listado (vet): Clic en "Guardar" [campos clinicos validos] o "Cancelar" / "Volver al listado" (CU-07)\n**28.** citas-listado (vet) -> buscar-historial: Clic en "Historial clinico" en menu lateral (CU-08)\n**29.** buscar-historial -> citas-listado (vet): Clic en "Consultar citas" en menu lateral o breadcrumb (CU-06)\n**30.** buscar-historial -> buscar-historial: Clic en "Buscar", "Limpiar" o "Historial clinico" en menu (CU-08)\n**31.** buscar-historial -> historial-detalle: Clic en "Ver historial" en fila de la tabla (CU-08)\n**32.** historial-detalle -> buscar-historial: Clic en "Volver al listado" o "Historial clinico" en menu/breadcrumb (CU-08) |
  |= Recepcion: Panel y Propietarios (33 - 47) |= Recepcion: Mascotas y Citas (48 - 65) |
  | **33.** Recepcionista -> index: Clic en "Cerrar sesion" desde cualquier vista del rol\n**34.** recepcionista-dashboard -> recepcionista-dashboard: Clic en "Panel principal" o logo "VetCare"\n**35.** recepcionista-dashboard -> propietarios-listado: Clic en "Propietarios" en menu lateral (CU-02)\n**36.** recepcionista-dashboard -> mascotas-listado: Clic en "Mascotas" en menu lateral (CU-03)\n**37.** recepcionista-dashboard -> citas-listado: Clic en "Citas" en menu lateral o "Ver todas" (CU-05.1)\n**38.** recepcionista-dashboard -> citas-reprogramar: Clic en "Reprogramar" [cita del dia Programada] (CU-05.2)\n**39.** recepcionista-dashboard -> citas-cancelar: Clic en "Cancelar cita" [cita del dia Programada] (CU-05.3)\n**40.** propietarios-listado -> propietarios-listado: Clic en "Buscar", "Limpiar" o "Propietarios" en menu (CU-02)\n**41.** propietarios-listado -> propietarios-nuevos: Clic en "Nuevo propietario" (CU-02)\n**42.** propietarios-listado -> propietarios-editar: Clic en "Editar" en fila de la tabla (CU-02)\n**43.** propietarios-listado -> propietarios-eliminar: Clic en "Eliminar" en fila de la tabla (CU-02)\n**44.** propietarios-nuevos -> propietarios-listado: Clic en "Guardar" [datos validos y checkbox mascota desmarcado] o "Cancelar" / "Volver al listado" (CU-02)\n**45.** propietarios-nuevos -> mascotas-nuevo: Clic en "Guardar" [datos validos y checkbox "Registrar una mascota..." marcado] (CU-02, CU-03)\n**46.** propietarios-editar -> propietarios-listado: Clic en "Guardar cambios" [datos validos] o "Cancelar" / "Volver al listado" (CU-02)\n**47.** propietarios-eliminar -> propietarios-listado: Clic en "Eliminar" [casilla marcada] o "Cancelar" / "Volver al listado" (CU-02) | **48.** mascotas-listado -> mascotas-listado: Clic en "Buscar", "Limpiar" o "Mascotas" en menu (CU-03)\n**49.** mascotas-listado -> mascotas-nuevo: Clic en "Nueva mascota" (CU-03)\n**50.** mascotas-listado -> mascotas-editar: Clic en "Editar" en fila de la tabla (CU-03)\n**51.** mascotas-listado -> mascotas-eliminar: Clic en "Eliminar" en fila de la tabla (CU-03)\n**52.** mascotas-nuevo -> mascotas-listado: Clic en "Guardar" [datos validos y checkbox cita desmarcado] o "Cancelar" / "Volver al listado" (CU-03)\n**53.** mascotas-nuevo -> citas-agendar: Clic en "Guardar" [datos validos y checkbox "Agendar una cita..." marcado] (CU-03, CU-04)\n**54.** mascotas-editar -> mascotas-listado: Clic en "Guardar cambios" [datos validos] o "Cancelar" / "Volver al listado" (CU-03)\n**55.** mascotas-eliminar -> mascotas-listado: Clic en "Eliminar" [casilla marcada] o "Cancelar" / "Volver al listado" (CU-03)\n**56.** citas-listado -> citas-listado: Clic en "Buscar", "Limpiar" o "Citas" en menu (CU-05.1)\n**57.** citas-listado -> citas-agendar: Clic en "Agendar cita" (CU-04)\n**58.** citas-listado -> citas-reprogramar: Clic en "Reprogramar" [cita Programada] (CU-05.2)\n**59.** citas-listado -> citas-cancelar: Clic en "Cancelar cita" [cita Programada] (CU-05.3)\n**60.** citas-agendar -> citas-agendar: Clic en "Buscar mascotas" [cedula valida de 10 digitos] (CU-04)\n**61.** citas-agendar -> citas-listado: Clic en "Guardar" [datos de cita validos] o "Cancelar" / "Volver al listado" (CU-04)\n**62.** citas-agendar -> propietarios-nuevos: Clic en "Nuevo propietario" en tarjeta "Registro previo" (CU-04, CU-02)\n**63.** citas-agendar -> mascotas-nuevo: Clic en "Nueva mascota" en tarjeta "Registro previo" (CU-04, CU-03)\n**64.** citas-reprogramar -> citas-listado: Clic en "Guardar cambios" [fecha/hora validas] o "Cancelar" / "Volver al listado" (CU-05.2)\n**65.** citas-cancelar -> citas-listado: Clic en "Confirmar cancelacion" [motivo valido y casilla marcada] o "Volver" / "Volver al listado" (CU-05.3) |
endlegend

@enduml
